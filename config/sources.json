      "verification_weight": 75,
      "allowed_for_verification": true
    },
    {
      "id": "event_platform",
      "name": "Event Platforms",
      "verification_weight": 70,
      "allowed_for_verification": true
    },
    {
      "id": "social",
      "name": "Social Media",
      "verification_weight": 60,
      "allowed_for_verification": false,
      "discovery_only": true
    },
    {
      "id": "aggregator",
      "name": "Aggregators",
      "verification_weight": 40,
      "allowed_for_verification": false,
      "discovery_only": true
    }
