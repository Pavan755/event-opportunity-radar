{
  "version": "2.0.0",
  "source_policy": {
    "require_evidence": true,
    "prefer_primary_sources": true,
    "allow_secondary_discovery": true,
    "social_media_requires_corroboration_when_possible": true,
    "never_treat_social_post_alone_as_full_verification": true,
    "never_infer_stipend": true,
    "never_infer_free_access": true,
    "never_infer_certificate": true,
    "never_infer_travel_support": true
  },
  "source_classes": [
    {
      "id": "official",
      "name": "Official Sources",
      "verification_weight": 100,
      "allowed_for_verification": true
    },
    {
      "id": "github",
      "name": "GitHub/Open Source",
      "verification_weight": 95,
      "allowed_for_verification": true
    },
    {
      "id": "community",
